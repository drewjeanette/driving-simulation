# Copy to .env.local (git-ignored) for local development.
#
# Both optional. With neither, the simulator drives a generated 3D road on
# OpenStreetMap data.
#
# Free 360° photos from Mapillary: get a client token (MLY|...) at
# https://www.mapillary.com/dashboard/developers
VITE_MAPILLARY_TOKEN=

# Google Maps + Street View (paid API with free monthly usage).
#
# The key ends up in the browser, as every Maps JavaScript key does, so lock it
# down in Google Cloud Console: restrict it to your HTTP referrers and to the
# APIs listed in README.md, and set daily quotas.
VITE_GOOGLE_MAPS_API_KEY=
